#!/usr/bin/env bash

# Focus the TUIOS window running agent session <id>, or fall back to the given resume command.
# Used as an Atuin [threads.resume] command.
# Usage: tuios-thread-open <id> <resume-command>...

set -eu

id="${1}"
shift

if [[ -n ${TUIOS_ENV:-} ]] && command -v tuios &>/dev/null; then
   row=$(
      tuios list-agents --all-sessions --json 2>/dev/null |
      jq -r --arg id "${id}" '.agents[] | select(.agent_session_id == $id) | "\(.session)\t\(.window_id)"' |
      head -n1
   ) || row=""

   if [[ -n "${row}" ]]; then
      IFS=$'\t' read -r session window <<< "${row}"
      if [[ "${session}" != "${TUIOS_SESSION:-}" ]]; then
         tuios switch-session "${session}"
      fi
      exec tuios focus-window -s "${session}" "${window}" >/dev/null
   fi
fi

exec "$@"
